# Conexão da aplicação: use o papel sisti_app (sem DELETE, sujeito ao RLS)
DATABASE_URL=postgres://sisti_app:troque-esta-senha@localhost:5432/sisti
# Segredo do token de sessão: mínimo 32 caracteres aleatórios (ex.: openssl rand -hex 32)
JWT_SECRET=troque-por-um-segredo-com-pelo-menos-32-caracteres
# Duração da sessão em horas
JWT_HORAS=12
# Porta do SisTI no seu computador (Docker usa SISTI_PORTA; execução direta usa PORT)
SISTI_PORTA=3010
PORT=3010
DB_POOL_MAX=10
# 0 desliga o log de cada requisição
LOG_REQUISICOES=1
# Monitor de comunicação dos PDVs: segundos entre testes (0 desliga), porta TCP opcional e Zabbix opcional
PDV_MONITOR_SEGUNDOS=60
PDV_PORTA_TCP=
ZABBIX_URL=
ZABBIX_TOKEN=
