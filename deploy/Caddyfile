# Proxy HTTPS do SisTI.
# SISTI_DOMINIO: nome(s) de acesso, ex.: "sisti.empresa.local" ou "sisti.empresa.local, 192.168.0.20"
# SISTI_TLS: "internal" (certificado gerado pelo próprio Caddy; instale a CA nos computadores)
#            ou "/certs/sisti.crt /certs/sisti.key" (certificado da empresa em deploy/certs)
{$SISTI_DOMINIO} {
	tls {$SISTI_TLS}
	encode zstd gzip
	reverse_proxy app:3000
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "same-origin"
		-Server
	}
}
