# Copie para .env.producao (na raiz do projeto) e preencha. NUNCA envie esse arquivo ao Git.
# Gere senhas com: openssl rand -hex 24   (use só letras e números: vão dentro de URLs)

# Endereço de acesso (crie o registro no DNS interno apontando para o IP do servidor)
# Inclua também o IP para acessar por ele: sisti.empresa.local, 10.10.4.14
SISTI_DOMINIO=sisti.empresa.local
# IP do servidor (necessário para o HTTPS funcionar quando se acessa pelo IP)
SISTI_IP=
# internal = certificado do próprio Caddy | ou: /certs/sisti.crt /certs/sisti.key
SISTI_TLS=internal

DB_OWNER_PASSWORD=
DB_APP_PASSWORD=
# Porta do banco no próprio servidor (127.0.0.1), para o pgAdmin via túnel SSH
DB_PORTA_LOCAL=5432
# openssl rand -hex 32
JWT_SECRET=
JWT_HORAS=12

# Primeiro administrador (usado só na primeira inicialização; depois apague ADMIN_SENHA daqui)
ADMIN_LOGIN=admin
ADMIN_EMAIL=ti@empresa.com.br
ADMIN_SENHA=

# Backup diário
BACKUP_HORA=02:00
BACKUP_DIAS=30
BACKUP_PASTA=./backups

# Monitor de comunicação dos PDVs e Zabbix: desde a 1.4.0 ficam na tela Parâmetros.
# Os valores abaixo só são importados na primeira inicialização (se a tela nunca foi alterada); depois, use a tela.
# Intervalo do teste em segundos (0 desliga). O servidor precisa alcançar a rede das lojas.
PDV_MONITOR_SEGUNDOS=60
# Se os PDVs bloqueiam ping, informe uma porta TCP que eles sempre atendem (ex.: 3389 ou a do agente Zabbix, 10050)
PDV_PORTA_TCP=
# Zabbix (opcional): disponibilidade e alertas ativos de cada PDV, procurado pelo IP
# Crie um usuário só de leitura no Zabbix e um token em Usuários > Tokens de API
ZABBIX_URL=
ZABBIX_TOKEN=

TZ=America/Sao_Paulo
