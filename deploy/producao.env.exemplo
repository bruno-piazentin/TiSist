# Copie para .env.producao (na raiz do projeto) e preencha. NUNCA envie esse arquivo ao Git.
# Gere senhas com: openssl rand -hex 24   (use só letras e números: vão dentro de URLs)

# Endereço de acesso (crie o registro no DNS interno apontando para o IP do servidor)
# Inclua também o IP para acessar por ele: sisti.empresa.local, 10.10.4.14
SISTI_DOMINIO=sisti.empresa.local
# IP do servidor (necessário para o HTTPS funcionar quando se acessa pelo IP)
SISTI_IP=
# internal = certificado do próprio Caddy | ou: /certs/sisti.crt /certs/sisti.key
SISTI_TLS=internal

DB_OWNER_PASSWORD=
DB_APP_PASSWORD=
# openssl rand -hex 32
JWT_SECRET=
JWT_HORAS=12

# Primeiro administrador (usado só na primeira inicialização; depois apague ADMIN_SENHA daqui)
ADMIN_LOGIN=admin
ADMIN_EMAIL=ti@empresa.com.br
ADMIN_SENHA=

# Backup diário
BACKUP_HORA=02:00
BACKUP_DIAS=30
BACKUP_PASTA=./backups

TZ=America/Sao_Paulo
